NOTION_TOKEN=
NOTION_DATABASE_AGENDAMENTOS=
NOTION_DATABASE_CAMPANHAS=
SENDFLOW_API_TOKEN=
SENDFLOW_API_URL=https://southamerica-east1-whatsapp-ultimate.cloudfunctions.net
SENDFLOW_ACCOUNT_ID=
SENDFLOW_NUMBER=
WEBHOOK_PORT=3001
WEBHOOK_SECRET=
CLOUDFLARE_TUNNEL_DOMAIN=sendflow.pixelnrock.com

# ─── Tráfego (otimização autônoma de Meta Ads) ───
# Token de usuário do sistema (Business Manager) com ads_read + ads_management
META_ACCESS_TOKEN=
# Pixel/dataset que recebe LeadQualificado e Purchase pela Conversions API
META_PIXEL_ID=
META_API_VERSION=v21.0
# Chave da Anthropic para o cérebro diário (sem ela o resumo sai só pelas regras)
ANTHROPIC_API_KEY=
# 1 = não executa nada no Meta, só loga (útil nos primeiros dias)
TRAFEGO_DRY_RUN=1
# Protege /api/trafego/lead, /pesquisa, /evento e /compra (header x-trafego-secret ou ?secret=)
TRAFEGO_WEBHOOK_SECRET=
# Horário do relatório diário (cron, fuso America/Sao_Paulo)
TRAFEGO_HORA_RELATORIO=0 8 * * *
